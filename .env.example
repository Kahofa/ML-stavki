# Скопируйте в .env и заполните. Файл .env не коммитится.
# https://dashboard.api-football.com/register  (бесплатно: 100 запросов/сутки)
API_FOOTBALL_KEY=
# https://www.football-data.org/client/register (бесплатно: 10 запросов/мин, 12 турниров)
FOOTBALL_DATA_ORG_KEY=
# https://the-odds-api.com/#get-access (бесплатно: 500 кредитов/месяц)
ODDS_API_KEY=
# Необязательно: путь к SQLite-кэшу и папке отчётов
CACHE_DB=cache/football.sqlite
REPORT_DIR=output
TIMEZONE=Asia/Almaty
BANKROLL=1000
